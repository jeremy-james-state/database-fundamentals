{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Database Fundamentals",
  "colors": {
    "primary": "#BCD2C4",
    "light": "#BCD2C4",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "expanded": true,
        "pages": [
          "index",
          "quickstart",
          "blank"
        ]
      },
      {
        "group": "Concepts",
        "expanded": true,
        "pages": [
          "concepts/tables",
          "concepts/databases",
          "concepts/sql"
        ]
      },
      {
        "group": "Querying",
        "expanded": true,
        "pages": [
          "how-to/open-a-database",
          "how-to/select-columns",
          "how-to/filter-rows",
          "how-to/match-patterns",
          "how-to/sort-rows",
          "how-to/summarize-rows",
          "tutorials/query-a-table"
        ]
      },
      {
        "group": "Reference",
        "expanded": true,
        "pages": [
          "reference/select",
          "reference/where",
          "reference/like",
          "reference/order-by",
          "reference/aggregate-functions"
        ]
      },
      {
        "group": "Templates",
        "hidden": true,
        "pages": [
          "templates/index",
          "templates/how-to",
          "templates/tutorial",
          "templates/explanation",
          "templates/reference"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "appearance": {
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#141414"
    }
  }
}
